# Воркер = core-api + браузер. Chromium весит ~400 МБ, поэтому отдельный
# образ: класть его в core-api и адаптер незачем.
# Контекст сборки — КОРЕНЬ репозитория (нужен libs/contracts).
FROM python:3.12-slim

WORKDIR /app

COPY libs/contracts /libs/contracts
RUN pip install --no-cache-dir /libs/contracts

COPY services/core-api/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt playwright==1.49.1

# Библиотеки ставим списком, а не через --with-deps: тот тянет ubuntu-шный
# ttf-ubuntu-font-family, которого в bookworm нет, и сборка падает.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libdrm2 libxkbcommon0 libatspi2.0-0 libxcomposite1 libxdamage1 \
    libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
    libx11-6 libxcb1 libxext6 fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Браузер лежит в общесистемном каталоге: ставится от root, читается
# воркером. Класть его в домашний каталог пользователя пришлось бы после
# смены USER, а установщику нужны права.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN playwright install chromium && chmod -R a+rX /opt/ms-playwright

COPY services/core-api/alembic.ini ./
COPY services/core-api/alembic/ ./alembic/
COPY services/core-api/app/ ./app/

# Chromium запускается с --no-sandbox (в контейнере нет user namespaces),
# поэтому единственный рубеж — изоляция самого контейнера. От root её
# ослаблять не стоит.
RUN useradd -r -u 1001 -m -s /bin/false celery && chown -R celery /app
USER celery

ENV PYTHONUNBUFFERED=1 \
    FILES_DIR=/app/storage

# Миграции накатывает core-api; воркер только исполняет задачи.
#
# --concurrency 1 намеренно: браузерный прогон должен идти в одном
# экземпляре, иначе два прохода одновременно вдвое чаще бьют по carcheck и
# роняют оценку reCAPTCHA. Плата — короткие задачи (пробник, ручной запуск
# из админки) ждут в очереди, пока идёт проверка парка; реальное состояние
# видно в журнале прогонов, поэтому ложного сигнала о зависшем воркере не
# возникает. Разводить задачи по очередям есть смысл, когда браузерных
# задач станет больше одной.
CMD ["celery", "-A", "app.tasks.celery_app:celery_app", "worker", "-l", "info", "--concurrency", "1"]
