# --- Общее -----------------------------------------------------------------
TZ=Asia/Bishkek
ADMIN_IDS=111111111,222222222

# --- Токены (разные области; не переиспользовать один и тот же) -------------
# Бот -> core-api: домен и команды блокировки
CORE_API_TOKEN=change-me-core
# Адаптер -> core-api: ТОЛЬКО POST /telemetry/batch
INGEST_TOKEN=change-me-ingest
# core-api -> адаптер: команды на трекер
ADAPTER_TOKEN=change-me-adapter

# --- Бот -------------------------------------------------------------------
BOT_TOKEN=123456:AA...
CORE_API_URL=http://core-api:8000
REMINDERS_ENABLED=1
REMINDER_HOUR=9

# --- core-api --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://tg_auto:tg_auto@postgres:5432/tg_auto
FILES_DIR=/app/storage
INVITE_TTL_HOURS=24
INVITE_TTL_MINUTES=0
ADAPTER_URL=http://tracker-adapter:8001
# Правила и тайминги
RULES_ENABLED=1
RULES_INTERVAL_SECONDS=120
TELEMETRY_STALE_SECONDS=300
COMMAND_ACK_WINDOW_SECONDS=180
COMMAND_DEDUP_SECONDS=60
TELEMETRY_RETENTION_DAYS=180
# ИИ (распознавание чеков и ассистент)
# Backend: auto | http | api | cli
#   auto — http при заданном GATEWAY_URL, иначе api при ANTHROPIC_API_KEY,
#          иначе cli (подписка);
#   http — через claude-gateway (так работает docker-compose: подписка живёт
#          в шлюзе, сервису не нужен ни ключ, ни claude в образе);
#   api  — Anthropic API по ключу;
#   cli  — Claude Code `claude -p` на подписке.
AI_BACKEND=http
GATEWAY_URL=http://claude_gw_api:8080
GATEWAY_API_KEY=
GATEWAY_MODEL=sonnet

# --- tracker-adapter -------------------------------------------------------
TRACCAR_URL=http://127.0.0.1:8082
TRACCAR_USER=service@traccar.local
TRACCAR_PASSWORD=change-me
TRACCAR_WS_ENABLED=1
TELEMETRY_BATCH_SIZE=50
TELEMETRY_FLUSH_SECONDS=10
POLL_INTERVAL_SECONDS=30
