# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=123456:ABC-DEF...

# ID администраторов через запятую (Telegram user id). Только здесь — не в боте.
ADMIN_IDS=111111111,222222222

# Подключение к PostgreSQL
DATABASE_URL=postgresql+asyncpg://tg_auto:tg_auto@localhost:5432/tg_auto

# Ключ Claude API для распознавания чеков и аналитики
ANTHROPIC_API_KEY=sk-ant-...

# Модель Claude для распознавания чеков / аналитики
ANTHROPIC_MODEL=claude-opus-4-8

# Папка для хранения загруженных файлов (фото машин, селфи, чеки)
FILES_DIR=./storage

# Срок жизни ссылки-приглашения в часах
INVITE_TTL_HOURS=24
