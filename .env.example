# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=123456:ABC-DEF...

# ID администраторов через запятую (Telegram user id). Только здесь — не в боте.
ADMIN_IDS=111111111,222222222

# Подключение к PostgreSQL
DATABASE_URL=postgresql+asyncpg://tg_auto:tg_auto@localhost:5432/tg_auto

# --- ИИ (распознавание чеков + аналитика) ---
# Backend: auto | http | api | cli
#   auto — http при заданном GATEWAY_URL, иначе api при ANTHROPIC_API_KEY,
#          иначе cli (подписка);
#   http — через claude-gateway по HTTP (так работает docker-compose:
#          подписка живёт в шлюзе, боту не нужен ни ключ, ни claude в образе);
#   api  — Anthropic API по ключу;
#   cli  — Claude Code `claude -p` на ПОДПИСКЕ Anthropic (ключ не нужен).
AI_BACKEND=auto
# Таймаут одного вызова ИИ, сек.
AI_TIMEOUT_SECONDS=120

# Путь через шлюз (backend=http). В docker-compose шлюз доступен по имени
# сервиса в общей сети claude_net.
GATEWAY_URL=
GATEWAY_API_KEY=
GATEWAY_MODEL=sonnet

# Путь через API-ключ (нужен только для backend=api).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Путь через подписку (backend=cli). Требует установленного и залогиненного
# `claude` (Claude Code CLI). Модель — алиас: sonnet | opus | haiku.
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=sonnet

# Папка для хранения загруженных файлов (фото машин, селфи, чеки)
FILES_DIR=./storage

# Срок жизни ссылки-приглашения в часах
INVITE_TTL_HOURS=24

# --- Напоминания о платежах ---
# Водителю: накануне, в день срока и при просрочке (не чаще 1 раза в день).
# Владельцу: утренняя сводка «кто платит сегодня / кто должен».
REMINDERS_ENABLED=1
# Часовой пояс парка (внутри всё считается в UTC).
TZ=Asia/Bishkek
# Час локального времени, когда уходит рассылка.
REMINDER_HOUR=9
